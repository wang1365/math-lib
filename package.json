{
  "name": "math-resources-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "next-sitemap -c next-sitemap.config.js",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.tsx",
    "test:routes": "node --import tsx --test tests/http/*.test.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run test:routes"
  },
  "dependencies": {
    "@formatjs/intl-localematcher": "^0.6.2",
    "@next/third-parties": "^16.2.6",
    "katex": "^0.16.25",
    "lucide-react": "^0.553.0",
    "negotiator": "^1.0.0",
    "next": "^16.2.6",
    "next-intl": "^4.5.3",
    "next-seo": "^7.0.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-katex": "^3.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.6",
    "jsdom": "^26.1.0",
    "next-sitemap": "^4.0.9",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
